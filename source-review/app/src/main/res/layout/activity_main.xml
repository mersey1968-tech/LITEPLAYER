<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- SurfaceView is required for HDR passthrough and display frame-rate control -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:show_timeout="3000"
        app:hide_on_touch="true" />


    <!-- Transparent interaction layer: controls do not exist onscreen until requested. -->
    <View
        android:id="@+id/revealControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Transient seek feedback; non-focusable and never intercepts remote input. -->
    <LinearLayout
        android:id="@+id/seekIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="116dp"
        android:background="#4D606060"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/seekTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="00:00 / 00:00"/>

        <ProgressBar
            android:id="@+id/seekProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="#99000000"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button android:id="@+id/rewindButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-10s" />
        <Button android:id="@+id/playPauseButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Pause" />
        <Button android:id="@+id/forwardButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+30s" />
        <Button android:id="@+id/seekSettingsButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Skip" />
        <Button android:id="@+id/audioSettingsButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Audio" />
    </LinearLayout>

    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/subtitleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="Subtitle size"
        android:visibility="gone" />



    <Button
        android:id="@+id/openButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Open video" />
</FrameLayout>
